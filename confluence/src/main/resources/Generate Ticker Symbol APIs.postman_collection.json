{
	"info": {
		"_postman_id": "c3d4e5f6-g7h8-9012-cdef-345678901234",
		"name": "Generate Ticker Symbol APIs",
		"description": "Collection for Generate Ticker Symbol for Company API - Retrieves ticker symbols from Yahoo Finance and creates Confluence content",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "98765432"
	},
	"item": [
		{
			"name": "Yahoo Finance Lookup - Direct API",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains HTML content\", function () {",
							"    pm.expect(pm.response.text()).to.include('html');",
							"});",
							"",
							"pm.test(\"Response contains ticker data\", function () {",
							"    const responseText = pm.response.text();",
							"    pm.expect(responseText).to.include('data-col0');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/html",
						"type": "text"
					},
					{
						"key": "User-Agent",
						"value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
						"type": "text"
					}
				],
				"url": {
					"raw": "https://finance.yahoo.com/lookup?s={{companyName}}",
					"protocol": "https",
					"host": [
						"finance.yahoo.com"
					],
					"path": [
						"lookup"
					],
					"query": [
						{
							"key": "s",
							"value": "{{companyName}}",
							"description": "Company name to search for"
						}
					]
				},
				"description": "Direct call to Yahoo Finance lookup API. This is the underlying API that the generateTickerSymbolForCompany method calls to retrieve ticker symbol information.\n\nThe method:\n1. Calls https://finance.yahoo.com/lookup?s={companyName}\n2. Parses the HTML response to find elements with class 'data-col0'\n3. Extracts the ticker symbol from data-symbol attribute\n4. Extracts the stock URL from href attribute\n5. Creates an anchor tag linking to the Yahoo Finance stock page\n\nExample company names to test:\n- Apple\n- Microsoft\n- Google\n- Amazon\n- Tesla"
			},
			"response": []
		},
		{
			"name": "Generate Ticker Symbol Content - Apple",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains Content entity\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('iD');",
							"    pm.expect(jsonData).to.have.property('body');",
							"});",
							"",
							"pm.test(\"Content body contains ticker symbol link\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.body).to.include('<a');",
							"    pm.expect(jsonData.body).to.include('href');",
							"    pm.expect(jsonData.body).to.include('finance.yahoo.com');",
							"});",
							"",
							"pm.test(\"Content contains Apple ticker (AAPL)\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.body).to.include('AAPL');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Basic {{base64_encoded_credentials}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"companyName\": \"Apple\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{krista_api_base_url}}/confluence/content/generate-ticker-symbol",
					"host": [
						"{{krista_api_base_url}}"
					],
					"path": [
						"confluence",
						"content",
						"generate-ticker-symbol"
					]
				},
				"description": "Generates ticker symbol content for Apple Inc. This corresponds to the generateTickerSymbolForCompany method in ContentArea.java.\n\nThe method:\n1. Calls Yahoo Finance lookup API with company name 'Apple'\n2. Parses the response to extract ticker symbol 'AAPL'\n3. Creates an HTML anchor tag linking to Apple's Yahoo Finance page\n4. Returns a Content entity with the generated HTML\n\nExpected response:\n- Content entity with UUID as iD\n- body containing: <a href=\"https://finance.yahoo.com/quote/AAPL\">AAPL</a>"
			},
			"response": []
		},
