		{
			"name": "Yahoo Finance Service Unavailable Test",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code indicates service error\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([500, 502, 503, 504]);",
							"});",
							"",
							"pm.test(\"Response indicates external service issue\", function () {",
							"    var responseText = pm.response.text();",
							"    const hasServiceError = responseText.includes('Yahoo Finance Service not available') ||",
							"                           responseText.includes('service') ||",
							"                           responseText.includes('unavailable');",
							"    pm.expect(hasServiceError).to.be.true;",
							"});"
						],
						"type": "text/javascript"
					}
				}
