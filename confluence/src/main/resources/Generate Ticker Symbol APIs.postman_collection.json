	"event": [
		{
			"listen": "prerequest",
			"script": {
				"id": "pre-request-script",
				"exec": [
					"// Encode credentials for Basic Auth",
					"const email = pm.environment.get('confluence_email');",
					"const token = pm.environment.get('api_token');",
					"if (email && token) {",
					"    const credentials = email + ':' + token;",
					"    const encodedCredentials = btoa(credentials);",
					"    pm.environment.set('base64_encoded_credentials', encodedCredentials);",
					"}",
					"",
					"// Set default company name if not provided",
					"if (!pm.environment.get('companyName')) {",
					"    pm.environment.set('companyName', 'Apple');",
					"}",
					"",
					"// Set default Krista API base URL if not provided",
					"if (!pm.environment.get('krista_api_base_url')) {",
					"    pm.environment.set('krista_api_base_url', 'https://your-krista-instance.com/api');",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "companyName",
			"value": "Apple",
			"type": "string",
			"description": "Default company name for ticker symbol lookup"
		},
		{
			"key": "krista_api_base_url",
			"value": "https://your-krista-instance.com/api",
			"type": "string",
			"description": "Base URL for Krista API endpoints"
		}
	]
