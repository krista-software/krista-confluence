		{
			"name": "Generate Ticker Symbol Content - Google (Alphabet)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Content contains Google/Alphabet ticker\", function () {",
							"    var jsonData = pm.response.json();",
							"    // Google has multiple ticker symbols (GOOGL, GOOG)",
							"    const hasGoogleTicker = jsonData.body.includes('GOOGL') || jsonData.body.includes('GOOG');",
							"    pm.expect(hasGoogleTicker).to.be.true;",
							"});",
							"",
							"pm.test(\"Content has unique ID\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.iD).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
