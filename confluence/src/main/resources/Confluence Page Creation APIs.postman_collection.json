	"item": [
		{
			"name": "Create Page from Content",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has page data\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('title');",
							"    pm.expect(jsonData).to.have.property('spaceId');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Basic {{base64_encoded_credentials}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"spaceId\": \"{{spaceId}}\",\n  \"status\": \"draft\",\n  \"title\": \"Test Page from Content\",\n  \"body\": {\n    \"representation\": \"storage\",\n    \"value\": \"<p>This is a test page created from content.</p><p>It contains multiple content blocks.</p><h2>Section 1</h2><p>Content for section 1</p><h2>Section 2</h2><p>Content for section 2</p>\"\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://{{domain}}/wiki/api/v2/pages",
					"protocol": "https",
					"host": [
						"{{domain}}"
					],
					"path": [
						"wiki",
						"api",
						"v2",
						"pages"
					]
				},
				"description": "Creates a new Confluence page from provided content. This corresponds to the createPageFromContent method in PageArea.java.\n\nRequired parameters:\n- spaceId: The ID of the space where the page will be created\n- title: The title of the new page\n- body.value: The HTML content for the page body\n\nThe content is provided as HTML in storage format, which gets processed and combined into the page body."
			},
			"response": []
		},
		{
			"name": "Create Page from Template",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has page data\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('title');",
							"    pm.expect(jsonData).to.have.property('spaceId');",
							"});"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Pre-request script to get template content if needed",
							"// This would typically fetch the template and prepare variables"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Basic {{base64_encoded_credentials}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"spaceId\": \"{{spaceId}}\",\n  \"status\": \"draft\",\n  \"title\": \"Test Page from Template\",\n  \"body\": {\n    \"representation\": \"storage\",\n    \"value\": \"<p>Welcome {{question}}</p><p>Answer: {{answer}}</p><p>This page was created from template ID: {{templateId}}</p>\"\n  }\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "https://{{domain}}/wiki/api/v2/pages",
					"protocol": "https",
					"host": [
						"{{domain}}"
					],
					"path": [
						"wiki",
						"api",
						"v2",
						"pages"
					]
				},
				"description": "Creates a new Confluence page from a template with variable substitution. This corresponds to the createPageFromTemplate method in PageArea.java.\n\nRequired parameters:\n- spaceId: The ID of the space where the page will be created\n- templateId: The ID of the template to use (referenced in environment)\n- title: The title of the new page\n- variables: Key-value pairs for template variable substitution\n\nThe template content is retrieved, variables are substituted, and the resulting content is used to create the page.\n\nExample variables:\n- question: \"What is Krista?\"\n- answer: \"Krista is a modern conversational Intelligent Automation platform\""
			},
			"response": []
		},
		{
			"name": "Get Template by ID",
			"event": [
				{
					"listen": "test",
					"script": {
