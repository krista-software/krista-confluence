							"    pm.expect(jsonData).to.have.property('name');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Basic {{base64_encoded_credentials}}",
						"type": "text"
					}
				],
				"url": {
					"raw": "https://{{domain}}/wiki/api/v2/templates/{{templateId}}",
					"protocol": "https",
					"host": [
						"{{domain}}"
					],
					"path": [
						"wiki",
						"api",
						"v2",
						"templates",
						"{{templateId}}"
					]
				},
				"description": "Retrieves template information by ID. This is used internally by the createPageFromTemplate method to fetch template content before variable substitution."
			},
			"response": []
		},
